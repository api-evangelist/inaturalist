{
  "opencollection": "1.0.0",
  "info": {
    "name": "iNaturalist Annotations Flags API",
    "version": "1.3.0"
  },
  "items": [
    {
      "info": {
        "name": "Flags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Flag Create",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/flags"
          },
          "docs": "Create a flag. To create a custom flag beyond the standard `spam` and\n`inappropriate` flags, set `flag` to `other` and include a `flag_explanation`\n"
        },
        {
          "info": {
            "name": "Flag Update",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/flags/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the record"
              }
            ]
          },
          "docs": "Update a flag. Generally only used to resolve the flag.\n"
        },
        {
          "info": {
            "name": "Flag Delete",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/flags/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the record"
              }
            ]
          },
          "docs": "Delete a flag\n"
        }
      ]
    }
  ],
  "bundled": true
}